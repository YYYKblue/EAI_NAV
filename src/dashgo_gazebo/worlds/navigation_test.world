<?xml version="1.0"?>
<sdf version="1.6">
  <world name="navigation_test">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="outer_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north_collision">
          <pose>0 3.95 0.5 0 0 0</pose>
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 3.95 0.5 0 0 0</pose>
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
        </visual>
        <collision name="south_collision">
          <pose>0 -3.95 0.5 0 0 0</pose>
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -3.95 0.5 0 0 0</pose>
          <geometry><box><size>8.0 0.1 1.0</size></box></geometry>
        </visual>
        <collision name="east_collision">
          <pose>3.95 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>3.95 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </visual>
        <collision name="west_collision">
          <pose>-3.95 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-3.95 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 8.0 1.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="vertical_partition">
      <static>true</static>
      <pose>1.0 -0.5 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.1 3.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="test_box">
      <static>true</static>
      <pose>-1.5 1.5 0.4 0 0 0</pose>
      <link name="box">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>

