<launch>
  <!-- Furniture from the original wpr_simulation RoboCup Home scene.
       Mesh/model assets are vendored into dashgo_gazebo, so this launch has no
       runtime dependency on the wpr_simulation package. -->
  <node name="spawn_bed" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/bed.model -x 5.0 -y -3.9 -z 0 -Y 3.14159 -urdf -model bed"
        output="screen" />
  <node name="spawn_sofa" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/sofa.model -x -1.0 -y -3.9 -z 0 -Y 1.57 -urdf -model sofa"
        output="screen" />
  <node name="spawn_tea_table" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/tea_table.model -x -2.1 -y -2.2 -z 0 -Y 1.57 -urdf -model tea_table"
        output="screen" />
  <node name="spawn_bookshelft" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/bookshelft.model -x 2.0 -y -0.55 -z 0 -Y -1.57 -urdf -model bookshelft"
        output="screen" />

  <node name="spawn_kitchen_table" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/table.model -x -3.5 -y 3.7 -z 0 -Y 1.57 -urdf -model kitchen_table"
        output="screen" />
  <node name="spawn_cupboard_0" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/cupboard.model -x -2.0 -y 0.7 -z 0 -Y 1.57 -urdf -model cupboard_0"
        output="screen" />
  <node name="spawn_cupboard_1" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/cupboard.model -x -1.3 -y 3.7 -z 0 -Y -1.57 -urdf -model cupboard_1"
        output="screen" />

  <node name="spawn_dinning_table_0" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/table.model -x 1.5 -y 1.5 -z 0 -Y 1.57 -urdf -model dinning_table_0"
        output="screen" />
  <node name="spawn_dinning_table_1" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/table.model -x 1.5 -y 2.0 -z 0 -Y 1.57 -urdf -model dinning_table_1"
        output="screen" />
  <node name="spawn_dinning_table_2" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/table.model -x 2.7 -y 1.5 -z 0 -Y 1.57 -urdf -model dinning_table_2"
        output="screen" />
  <node name="spawn_dinning_table_3" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/table.model -x 2.7 -y 2.0 -z 0 -Y 1.57 -urdf -model dinning_table_3"
        output="screen" />

  <node name="spawn_chair_0" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/chair.model -x 1.5 -y 1.2 -z 0 -Y 1.57 -urdf -model chair_0"
        output="screen" />
  <node name="spawn_chair_1" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/chair.model -x 1.5 -y 2.3 -z 0 -Y -1.57 -urdf -model chair_1"
        output="screen" />
  <node name="spawn_chair_2" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/chair.model -x 2.7 -y 1.2 -z 0 -Y 1.57 -urdf -model chair_2"
        output="screen" />
  <node name="spawn_chair_3" pkg="gazebo_ros" type="spawn_model"
        args="-wait dashgo -file $(find dashgo_gazebo)/models/chair.model -x 2.7 -y 2.3 -z 0 -Y -1.57 -urdf -model chair_3"
        output="screen" />
</launch>
