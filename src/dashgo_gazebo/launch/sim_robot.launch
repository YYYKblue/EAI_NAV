<launch>
  <arg name="world" default="$(find dashgo_gazebo)/worlds/robocup_home.world" />
  <arg name="spawn_scene_objects" default="true" />
  <arg name="gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="x" default="0.0" />
  <arg name="y" default="0.0" />
  <arg name="z" default="0.10" />
  <arg name="yaw" default="0.0" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="true" />
  </include>

  <include if="$(arg spawn_scene_objects)"
           file="$(find dashgo_gazebo)/launch/robocup_home_objects.launch" />

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find dashgo_gazebo)/urdf/dashgo.gazebo.xacro'" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen">
    <param name="publish_frequency" value="30.0" />
  </node>

  <node name="spawn_dashgo" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model dashgo -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)"
        output="screen" />

  <node name="sim_safety_cmd_gate" pkg="dashgo_gazebo"
        type="sim_safety_cmd_gate.py" output="screen">
    <param name="command_timeout" value="1.0" />
  </node>
</launch>
