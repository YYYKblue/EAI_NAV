<launch>
  <arg name="world" default="$(find dashgo_gazebo)/worlds/robocup_home.world" />
  <arg name="spawn_scene_objects" default="true" />
  <arg name="gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="rviz" default="true" />

  <include file="$(find dashgo_gazebo)/launch/sim_robot.launch">
    <arg name="world" value="$(arg world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="spawn_scene_objects" value="$(arg spawn_scene_objects)" />
  </include>

  <include file="$(find dashgo_bringup)/launch/mapping.launch">
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="use_driver" value="false" />
    <arg name="use_lidars" value="false" />
    <arg name="use_description" value="false" />
  </include>
</launch>
