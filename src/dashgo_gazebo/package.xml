<?xml version="1.0"?>
<package format="2">
  <name>dashgo_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Classic simulation and navigation integration for Dashgo.</description>

  <maintainer email="bboss@todo.todo">bboss</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>

  <exec_depend>dashgo_bringup</exec_depend>
  <exec_depend>dashgo_description</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
</package>
