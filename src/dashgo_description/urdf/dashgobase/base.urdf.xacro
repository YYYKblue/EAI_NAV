<?xml version="1.0"?>

<robot name="base" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define a number of dimensions using properties -->
  <!-- Measured outer chassis/wheel envelope, shared with the navigation
       footprint: [-0.283, 0.283] in base_footprint. -->
  <xacro:property name="base_x" value="0.566" />
  <xacro:property name="base_y" value="0.566" />
  <xacro:property name="base_length" value="0.20" />
  <xacro:property name="base_link_offset_x" value="0.115" />
  <xacro:property name="wheel_length" value="0.046" />
  <!-- Keep the displayed/physical wheel geometry aligned with the calibrated
       values used by dashgo_driver/config/base.yaml. -->
  <xacro:property name="wheel_radius" value="0.074" />
  <xacro:property name="wheel_offset_x" value="-0.08" />
  <xacro:property name="wheel_offset_y" value="0.2225" />
  <xacro:property name="wheel_offset_z" value="-0.038" />
  
  <xacro:property name="PI" value="3.1415926" />
     
  <!-- define a wheel -->
  <xacro:macro name="wheel" params="suffix parent reflect color">
    <joint name="${parent}_${suffix}_wheel_joint" type="continuous">
      <axis xyz="0 0 1" />
      <limit effort="100" velocity="100"/>
      <dynamics damping="0.2" friction="0.05" />
      <safety_controller k_velocity="10" />
      <!-- Both wheel joint axes must point in the same base-frame direction;
           mirroring the cylinder rotation would make equal Gazebo wheel
           velocities rotate the chassis instead of driving it straight. -->
      <origin xyz="${wheel_offset_x} ${reflect*wheel_offset_y} ${wheel_offset_z}" rpy="${-PI/2} 0 0" />
      <parent link="${parent}_link"/>
      <child link="${parent}_${suffix}_wheel_link"/>
    </joint>
    <link name="${parent}_${suffix}_wheel_link">
<!--
 <visual>
<origin xyz=" 0 0 0 " rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://common/urdf/meshes/wheel.STL" />
      </geometry>
      <material name="${color}" />
</visual>
-->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="${color}" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
      <!-- Idealized wheel mass/inertia for Gazebo. The measured drivetrain
           dimensions above remain the parameters relevant to kinematics. -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.5" />
        <inertia ixx="0.001011" ixy="0" ixz="0"
                 iyy="0.001011" iyz="0" izz="0.001369" />
      </inertial>
    </link>
  </xacro:macro>

  <!-- The base xacro macro -->
  <xacro:macro name="base" params="name color">
    <link name="${name}_link">

<!--
 <visual>
<origin xyz=" 0 0 0 " rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://common/urdf/meshes/dash_base_all.STL" />
      </geometry>
      <material name="">        
        <color
          rgba="255 215 0 0.5"/>
      </material>
</visual>
-->
        <visual>
            <!-- base_link is 0.115 m ahead of the measured footprint center. -->
            <origin xyz="${-base_link_offset_x} 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_x} ${base_y} ${base_length}"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <collision>
            <origin xyz="${-base_link_offset_x} 0 0" rpy="0 0 0"/>
            <geometry>
                 <box size="${base_x} ${base_y} ${base_length}"/>
            </geometry>
        </collision>
        <!-- Idealized uniform-box chassis mass/inertia. Its center is aligned
             with the measured footprint center; replace when measured. -->
        <inertial>
            <origin xyz="${-base_link_offset_x} 0 0" rpy="0 0 0"/>
            <mass value="20.0"/>
            <inertia ixx="0.600593" ixy="0" ixz="0"
                     iyy="0.600593" iyz="0" izz="1.067853"/>
        </inertial>
    </link>
  </xacro:macro>
  
  <link name="base_footprint">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.05 0.05 0.001" />
        </geometry>
        <material name="TransparentGreen" />
      </visual>
  </link>
  
  <joint name="base_joint" type="fixed">
<!--
    <origin xyz="0 0 0.04" rpy="0 0 0" />     
-->  
    <!-- Put base_footprint on the drive-wheel contact plane. -->
    <origin xyz="${base_link_offset_x} 0 ${wheel_radius - wheel_offset_z}" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link" />
  </joint>

   <!-- Add the drive wheels -->
   <xacro:wheel parent="base" suffix="l" reflect="1" color="Orange"/>
   <xacro:wheel parent="base" suffix="r" reflect="-1" color="Orange"/>

</robot>
