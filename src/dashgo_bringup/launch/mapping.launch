<launch>
  <arg name="rviz" default="false" />
  <arg name="scan_topic" default="scan" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_frame" default="odom_combined" />
  <arg name="map_frame" default="map" />

  <include file="$(find dashgo_bringup)/launch/base.launch" />

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping"
        output="screen" respawn="true">
    <rosparam command="load" file="$(find dashgo_bringup)/config/mapping/gmapping.yaml" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <remap from="scan" to="$(arg scan_topic)" />
  </node>

  <include if="$(arg rviz)" file="$(find dashgo_bringup)/launch/rviz.launch" />
</launch>
