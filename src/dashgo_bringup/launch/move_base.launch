<launch>
  <!-- 仅启动导航规划与可选安全节点；底盘、地图和定位/SLAM 由上层 launch 提供。 -->
  <arg name="safety_filters" default="true" />

  <node name="move_base" pkg="move_base" type="move_base"
        output="screen" respawn="true" clear_params="true">
    <!-- 公共 costmap 配置必须分别进入两个独立命名空间。 -->
    <rosparam command="load" ns="global_costmap"
              file="$(find dashgo_bringup)/config/navigation/costmap_common_params.yaml" />
    <rosparam command="load" ns="local_costmap"
              file="$(find dashgo_bringup)/config/navigation/costmap_common_params.yaml" />

    <!-- 再加载全局/局部差异以及规划器参数。 -->
    <rosparam command="load" file="$(find dashgo_bringup)/config/navigation/local_costmap_params.yaml" />
    <rosparam command="load" file="$(find dashgo_bringup)/config/navigation/global_costmap_params.yaml" />
    <rosparam command="load" file="$(find dashgo_bringup)/config/navigation/global_planner_params.yaml" />
    <rosparam command="load" file="$(find dashgo_bringup)/config/navigation/teb_local_planner_params.yaml" />
    <rosparam command="load" file="$(find dashgo_bringup)/config/navigation/move_base_params.yaml" />
  </node>

  <group if="$(arg safety_filters)">
    <node pkg="dashgo_bringup" type="laser_safety_gate.py"
          name="laser_safety_gate" output="screen">
      <rosparam command="load" file="$(find dashgo_bringup)/config/safety/box_filter.yaml" />
    </node>
    <node pkg="dashgo_bringup" type="laser_safety_gate.py"
          name="laser_safety_gate_2" output="screen">
      <rosparam command="load" file="$(find dashgo_bringup)/config/safety/box_filter_2.yaml" />
      <remap from="scan" to="scan_2" />
      <remap from="is_passed" to="is_passed_2" />
    </node>
  </group>
</launch>
